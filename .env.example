# Copiá este archivo como .env y completá los valores reales.
# El archivo .env NO se commitea (está en .gitignore).

# PostgreSQL local de desarrollo
DB_USERNAME=financia
DB_PASSWORD=poné-tu-password-local

# JWT — obligatoria, mínimo 32 caracteres.
# Generá una con: openssl rand -base64 48
JWT_SECRET=poné-un-secreto-de-al-menos-32-caracteres

# Opcional: API key de Groq. Sin ella, la IA usa fallback rule-based.
GROQ_API_KEY=
